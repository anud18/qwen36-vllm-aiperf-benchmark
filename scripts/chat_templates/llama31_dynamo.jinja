{#- Llama 3.1 chat template matching what the optimumxt Dynamo endpoint applied.
     The NousResearch mirror ships a 348-char template with no system block; Dynamo
     applied Meta's official one, worth exactly 25 tokens per request. Verified:
       - vs endpoint per-request records: all 20 of cf_llama31_chatbot diff = 0,
         ISL sum 12,176 = 12,176 (was 11,676 without this)
       - vs Meta's official template (via unsloth mirror): token-identical across
         150 chatbot + 150 agent entries, diffs all 0
     Only textual difference from official is the date -- official hardcodes
     "26 Jul 2024", this emits today's. Same token count, so ISL is unaffected,
     and OSL is pinned by ignore_eos regardless. -#}
{%- set loop_messages = messages %}
{%- set sysblock = '<|start_header_id|>system<|end_header_id|>\n\nCutting Knowledge Date: December 2023\nToday Date: ' + strftime_now('%d %b %Y') + '\n\n<|eot_id|>' %}
{{- bos_token + sysblock }}
{%- for message in loop_messages %}
{{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' + message['content'] | trim + '<|eot_id|>' }}
{%- endfor %}
{{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
